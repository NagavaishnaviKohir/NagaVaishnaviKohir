import json
from datetime import datetime

FILE = "expenses.json"

def load_expenses():
    try:
        with open(FILE, "r") as f:
            return json.load(f)
    except FileNotFoundError:
        return []

def save_expenses(data):
    with open(FILE, "w") as f:
        json.dump(data, f, indent=2)

def add_expense(amount, category, note=""):
    data = load_expenses()
    data.append({"amount": amount, "category": category, "note": note, "date": str(datetime.now())})
    save_expenses(data)
    print("Added:", amount, category)

def list_expenses():
    data = load_expenses()
    total = 0
    for e in data:
        print(f"{e['date'][:10]} - {e['category']} - ${e['amount']} {e['note']}")
        total += e['amount']
    print("Total:", total)

if __name__ == "__main__":
    import sys
    if len(sys.argv) < 2:
        print("Usage: python expense_tracker.py [add/list] [args]")
    elif sys.argv[1] == "add":
        add_expense(float(sys.argv[2]), sys.argv[3], " ".join(sys.argv[4:]))
    elif sys.argv[1] == "list":
        list_expenses()
